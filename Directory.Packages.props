<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Test stack: xunit.v3 on the Microsoft Testing Platform. MTP (not VSTest) is
    the path the .NET 10 SDK steers toward, and xunit v3 test projects are
    executables that host their own runner, hence no Microsoft.NET.Test.Sdk and
    no xunit.runner.visualstudio.

    Coverage comes from Microsoft.Testing.Extensions.CodeCoverage;
    coverlet.collector is a VSTest data collector and does not work under MTP.
    TRX reporting is built into xunit.v3 (see the report switch used in CI).
  -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>
</Project>
