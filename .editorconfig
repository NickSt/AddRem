# EditorConfig for AddRem
#
# CSharpier owns formatting. It reads indent_style, indent_size, end_of_line and
# max_line_length from this file; everything else about whitespace is its
# business, so do not add whitespace rules here expecting them to win.
# This file carries encoding, the style rules CSharpier does not cover,
# naming rules, and analyzer severities.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
indent_size = 2

[*.{yml,yaml}]
end_of_line = lf

[*.cs]
indent_size = 4
max_line_length = 100

#### Language conventions CSharpier does not cover ####

csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

#### Naming ####

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.i_prefixed.capitalization = pascal_case
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.async_suffixed.capitalization = pascal_case
dotnet_naming_style.async_suffixed.required_suffix = Async

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefixed
dotnet_naming_rule.interfaces_i_prefix.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = property,method,event,namespace,class,struct,enum,delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public,protected,internal
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal_case
dotnet_naming_rule.public_members_pascal.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter,local
dotnet_naming_rule.parameters_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_camel.style = camel_case
dotnet_naming_rule.parameters_camel.severity = suggestion

#### Analyzer severities ####

# Platform compatibility is genuinely load-bearing in this repo: the whole
# library is Windows-only and parts of it are gated on Windows 10 versions.
dotnet_diagnostic.CA1416.severity = error

dotnet_diagnostic.CA1062.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# CSharpier decides using placement and ordering; IDE0055 would double-report.
dotnet_diagnostic.IDE0055.severity = none

[tests/**/*.cs]
# Test method names read better with underscores, and tests do not ship docs.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1062.severity = none
