<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- M1 removes this line so the net10.0-windows default in
         Directory.Build.props takes effect. -->
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <!--
    TEMPORARY - removed in M1.

    App.cs / AppManager.cs / RegKeys.cs are the pre-existing scratch code and are
    deleted wholesale in M1. They do not survive the strict settings this
    milestone introduces (missing XML docs, a malformed doc comment, SCREAMING_CASE
    consts, a bare `throw new Exception()`, an unvalidated public ctor parameter).
    Suppressing here keeps M0 scoped to "prove the tooling and CI work" rather
    than mixing in a rewrite. Delete this block together with those files.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1570;CS1591;CA1062;CA1707;CA2201</NoWarn>
  </PropertyGroup>
</Project>
