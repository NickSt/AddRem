# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.json    text
*.md      text
*.yml     text eol=lf
*.yaml    text eol=lf

# Shell scripts and git hooks must be LF or /bin/sh will not run them.
*.sh          text eol=lf
.githooks/*   text eol=lf

# Binaries
*.png binary
*.ico binary
*.snk binary
